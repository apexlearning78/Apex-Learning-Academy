rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() &&
        (request.auth.token.admin == true ||
         request.auth.uid == 'VHbqYaHK6yXP2f8IF9WKc33kkD73');
    }
    function own(uid) { return signedIn() && request.auth.uid == uid; }

    match /courses/{id} { allow read: if true; allow write: if admin(); }
    match /certificates/{id} { allow read: if true; allow create, update, delete: if admin(); }
    match /students/{uid} {
      allow read: if own(uid) || admin();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if own(uid) || admin();
      allow delete: if admin();
    }
    match /attendance/{id} {
      allow read: if admin() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create, update, delete: if admin() || (signedIn() && request.resource.data.studentUid == request.auth.uid);
    }
    match /results/{id} {
      allow read: if admin() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow write: if admin();
    }
    match /marksheets/{id} { allow read: if admin() || (signedIn() && resource.data.studentUid == request.auth.uid); allow write: if admin(); }
    match /testSubmissions/{id} { allow create: if signedIn(); allow read, update, delete: if admin() || (signedIn() && resource.data.studentUid == request.auth.uid); }
    match /liveClasses/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /announcements/{id} { allow read: if true; allow write: if admin(); }
    match /reviews/{id} { allow read: if true; allow create: if signedIn(); allow update, delete: if admin(); }
    match /messages/{id} { allow create: if true; allow read, update, delete: if admin(); }
    match /instructorApplications/{id} { allow create: if true; allow read, update, delete: if admin(); }
    match /coupons/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /emailLogs/{id} { allow read, write: if admin(); }
    match /visitors/{id} { allow create: if true; allow read, update, delete: if admin(); }
    match /visits/{id} { allow create: if true; allow read, update, delete: if admin(); }
    match /fees/{id} { allow read, write: if admin() || (signedIn() && resource.data.studentUid == request.auth.uid); }
    match /courseProgress/{id} { allow read: if admin() || (signedIn() && resource.data.studentUid == request.auth.uid); allow write: if admin() || (signedIn() && request.resource.data.studentUid == request.auth.uid); }
    match /batches/{id} { allow read: if signedIn(); allow write: if admin(); }

    match /enrollments/{id} { allow read: if admin() || (signedIn() && resource.data.studentUid == request.auth.uid); allow create, update, delete: if admin(); }
    match /assignments/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /quizzes/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /invoices/{id} { allow read: if admin() || (signedIn() && resource.data.studentUid == request.auth.uid); allow write: if admin(); }
    match /leads/{id} { allow read, write: if admin(); }
    match /adminActivity/{id} { allow read, create: if admin(); allow update, delete: if admin(); }
    match /academySettings/{id} { allow read: if true; allow write: if admin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
